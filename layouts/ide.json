{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    14,
    13
  ],
  "background": "canvas",
  "terminal_padding": [
    10,
    8
  ],
  "preview": "layouts/ide.svg",
  "link_handlers": [
    "ide-editor"
  ],
  "children": [
    {
      "id": "titlebar",
      "type": "block",
      "size": {
        "px": 40
      },
      "window_drag": true,
      "content": {
        "mod": "ide-titlebar"
      }
    },
    {
      "id": "body",
      "type": "row",
      "divider": {
        "width": 0,
        "color": "#00000000",
        "hover": "accent"
      },
      "children": [
        {
          "id": "sidebar",
          "type": "stack",
          "background": {
            "gradient": [
              "#ffffff26",
              "#ffffff00"
            ],
            "angle": 180
          },
          "active": "view-explorer",
          "size": {
            "px": 300
          },
          "min": 200,
          "max": 720,
          "children": [
            {
              "id": "view-explorer",
              "type": "block",
              "content": {
                "mod": "ide-explorer"
              }
            },
            {
              "id": "view-git",
              "type": "block",
              "content": {
                "mod": "ide-git"
              }
            },
            {
              "id": "view-search",
              "type": "block",
              "content": {
                "mod": "ide-find"
              }
            },
            {
              "id": "view-problems",
              "type": "block",
              "content": {
                "mod": "ide-problems"
              }
            },
            {
              "id": "view-spaces",
              "type": "block",
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "view-agents",
              "type": "block",
              "content": {
                "mod": "agents"
              }
            }
          ],
          "radius": 16,
          "border": {
            "width": 1,
            "color": "border"
          },
          "shadow": "lg"
        },
        {
          "id": "center",
          "type": "column",
          "background": {
            "gradient": [
              "#ffffff26",
              "#ffffff00"
            ],
            "angle": 180
          },
          "resizable": false,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "size": {
                "px": 34
              },
              "content": {
                "mod": "ide-tabs"
              }
            },
            {
              "id": "terminals",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "background": "#00000000",
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 26,
                    "position": "top"
                  },
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 6
                }
              }
            }
          ],
          "radius": 16,
          "border": {
            "width": 1,
            "color": "border"
          },
          "shadow": "lg"
        }
      ],
      "gap": 8,
      "padding": [
        2,
        8
      ]
    },
    {
      "id": "status",
      "type": "block",
      "size": {
        "px": 34
      },
      "content": {
        "mod": "ide-status"
      }
    }
  ],
  "theme": {
    "light": "liquid-glass-light",
    "dark": "liquid-glass-dark"
  },
  "window_blur": true,
  "terminal_opacity": 0.4
}
